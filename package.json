{
  "name": "dom-importer",
  "version": "1.0.1",
  "description": "Scans the DOM and dynamically imports JavaScript modules when matching elements are found. Supports lazy loading, lifecycle hooks, and SPA-friendly DOM watching.",
  "license": "MIT",
  "author": "ramirezcgn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramirezcgn/dom-importer.git"
  },
  "bugs": {
    "url": "https://github.com/ramirezcgn/dom-importer/issues"
  },
  "homepage": "https://github.com/ramirezcgn/dom-importer#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node build.js",
    "test": "jest",
    "publish": "npm run build && npm test && npm publish"
  },
  "keywords": [
    "dom",
    "loader",
    "dynamic-import",
    "lazy-load",
    "component-loader",
    "intersection-observer",
    "mutation-observer",
    "spa",
    "progressive-enhancement",
    "vanilla-js",
    "framework-agnostic"
  ],
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "esbuild": "^0.25.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.8.0"
  }
}
